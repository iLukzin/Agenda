# Supabase — copie para .env.local e preencha
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key — usada apenas no servidor para criar usuários sem confirmação de email
# Encontre em: Supabase → Settings → API → service_role (secret)
# NUNCA exponha esta chave no frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
